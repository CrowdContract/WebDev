# ─────────────────────────────────────────
#  Environment Variables — .env.example
#  Copy this file to .env and fill values.
# ─────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_NAME=MyApp

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=myuser
DB_PASSWORD=yourpassword

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# External APIs
API_KEY=your_api_key_here
